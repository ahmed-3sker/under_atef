MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/under_atef
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
PORT=5000
# set to 1 only if your network can't resolve the Atlas SRV record
FORCE_PUBLIC_DNS=0

# used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
